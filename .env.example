# API keys for the vendored llm_gateway (free-tier providers, no credit card).
# Copy to .env (gitignored) and fill in, or keep keys globally in ~/.llm_gateway/.env.
# Search order: $LLM_GATEWAY_ENV, ./.env, ~/.llm_gateway/.env — real env vars always win.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional providers (disabled by default in the gateway registry):
# CEREBRAS_API_KEY=
# GITHUB_TOKEN=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
